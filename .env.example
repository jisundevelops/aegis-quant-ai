# ============================================================
# Aegis Quant AI — Environment Variables Template
# ------------------------------------------------------------
# Copy this file to `.env` and fill in your credentials.
# The real `.env` file MUST NEVER be committed to git.
# ============================================================

# ---------- Application ----------
APP_ENV=development
APP_NAME=Aegis Quant AI
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- Database URLs (Phase 2 — take priority when set) ----------
# If set, these OVERRIDE the individual POSTGRES_* / REDIS_* fields below.
# Remember to URL-encode any special characters in passwords (e.g. @ -> %40).
# For TLS-secured Redis (e.g. Upstash), use rediss:// (two s's) instead of redis://.
DATABASE_URL=
REDIS_URL=

# ---------- PostgreSQL (fallback — used only if DATABASE_URL is empty) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aegis
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aegis_quant
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ---------- Redis (fallback — used only if REDIS_URL is empty) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_NAMESPACE=aegis

# ---------- Binance API ----------
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ---------- Yahoo Finance ----------
# yfinance does not require a key for basic usage.
YFINANCE_USER_AGENT=AegisQuantAI/0.1

# ---------- MetaTrader 5 ----------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# ---------- LLM Providers (optional) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- News / Sentiment Feeds ----------
NEWS_API_KEY=
ALPHAVANTAGE_API_KEY=

# ---------- Security ----------
JWT_SECRET=please-replace-with-a-long-random-string
API_KEY_HEADER=X-Aegis-Key

# ---------- GitHub (used by CI scripts; do not commit) ----------
GITHUB_TOKEN=
